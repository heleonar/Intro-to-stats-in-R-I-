df3 |>
ggplot(aes(x=Species, y=Sepal.Length))+
geom_boxplot()
df<-iris
library(tidyverse)
library(rstatix)
library(broom)
df |>
group_by(Species) |>
lm(Sepal.Length~Sepal.Width, data= _)
df |>
ggplot(aes(x=Sepal.Length))+
geom_density()
df |>
ggplot(aes(x=Sepal.Width))+
geom_density()
df |>
group_by(Species) |>
lm(Sepal.Length~Sepal.Width, data= _)
View(df)
model<-lm(Sepal.Length~Sepal.Width, data= df)
summary(model)
aov(model)
df |>
ggplot(aes(x=Sepal.Length, y=Sepal.Width, color=Species))+
geom_smooth(method = lm)
df |>
ggplot(aes(x=Sepal.Length, y=Sepal.Width, color=Species))+
geom_smooth(method = lm)+
geom_point()
df |>
ggplot(aes(x=Sepal.Length, y=Sepal.Width, color=Species))+
geom_smooth(method = lm)+
geom_point()+
facet_wrap(~Species)
tukey_hsd(model)
model<-lm(Sepal.Length~Sepal.Width, data= df)
summary(model)
tukey_hsd(model)
TukeyHSD(model)
