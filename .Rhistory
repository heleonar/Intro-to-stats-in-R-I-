filter(sex!='') |>
ggplot(aes(x= species, y= body_mass_g, fill= sex+species))+
geom_boxplot()
df |>
filter(sex!='') |>
ggplot(aes(x= species, y= body_mass_g, fill= sex, color= species))+
geom_boxplot()
df |>
filter(sex!='') |>
ggplot(aes(x= species, y= body_mass_g, fill= sex))+
geom_boxplot()
model<-aov(body_mass_g ~ sex*species, data = df)
summary(model)
TukeyHSD(model, which = 'species')
TukeyHSD(model)
plot(TukeyHSD(model, which = 'sex:species'))
plot(TukeyHSD(model, which = 'sex:species'),
las= 2)
#note that these are not the same results!
par(mar=c(4.1, 4.1, 4.1, 4.1))
plot(TukeyHSD(model, which = 'sex:species'),
las= 2)
#note that these are not the same results!
par(mar=c(14.1, 4.1, 4.1, 4.1))
plot(TukeyHSD(model, which = 'sex:species'),
las= 2)
#note that these are not the same results!
par(mar=c(4.1, 14.1, 4.1, 4.1))
plot(TukeyHSD(model, which = 'sex:species'),
las= 2)
#note that these are not the same results!
par(mar=c(4.1, 4.1, 14.1, 4.1))
plot(TukeyHSD(model, which = 'sex:species'),
las= 2)
#note that these are not the same results!
par(mar=c(4.1, 4.1, 4.1, 14.1))
plot(TukeyHSD(model, which = 'sex:species'),
las= 2)
#note that these are not the same results!
par(mar=c(4.1, 14.1, 4.1, 4.1))
plot(TukeyHSD(model, which = 'sex:species'),
las= 2)
dev.off()
df |>
filter(sex!='') |>
ggplot(aes(x= species, y= body_mass_g, fill= sex))+
geom_boxplot()
model<-aov(body_mass_g ~ sex*species, data = df)
summary(model)
plot(TukeyHSD(model, which = 'sex:species'),
las= 2)
library(ggpubr)
ggline(subset(df, sex!=''),
x= 'species',
y= 'body_mass_g',
color= 'sex')
ggline(subset(df, sex!=''),
x= 'species',
y= 'body_mass_g',
color= 'sex',
add = c('mean_se'))
ggline(subset(df, sex!=''),
x= 'species',
y= 'body_mass_g',
color= 'sex',
add = c('mean_se'))+
labs(y= 'Mean body mass (g)')
df |>
filter(sex!='') |>
ggplot(aes(x= species, y= body_mass_g, color= sex))+
geom_errorbar(aes(ymin= body_mass_g-se, ymax= body_mass_g+se))
df |>
filter(sex!='') |>
ggplot(aes(x= species, y= body_mass_g, color= sex))+
geom_errorbar(aes(ymin= body_mass_g-se, ymax= body_mass_g+se))+
geom_point()
df |>
filter(sex!='') |>
ggplot(aes(x= species, y= body_mass_g, color= sex))+
geom_errorbar(aes(ymin= body_mass_g - se, ymax= body_mass_g + se))+
geom_point()
model<-aov(body_mass_g ~ sex*species, data = df)
summary(model)
model<-aov(body_mass_g ~ sex+species, data = df)
summary(model)
