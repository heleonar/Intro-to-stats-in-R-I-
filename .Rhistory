# Libraries and data ------------------------------------------------------
library(tidyverse)
library(car) # car package holds the Anova function, used for Type II and III anovas
library(rstatix) # for shapiro test and tukey_hsd
library(skimr) #for quick descriptive metrics of a data set
library(palmerpenguins)
df<-penguins
df |>
ggplot(aes(x=species, y=body_mass_g))+
geom_boxplot()
skim(df)
anova(model)
model<- lm(data = na.omit(df), body_mass_g~species)
anova(model)
Anova(model, type = 'II')
model<- aov(data = na.omit(df), body_mass_g~species)
# now pass the model into the summary() function to generate an anova table
summary(model)
model<- lm(data = na.omit(df), body_mass_g~species)
summary(model)
test<-data.frame(tukey_hsd(model))
View(test)
model<- aov(data = na.omit(df), body_mass_g~species)
# now pass the model into the summary() function to generate an anova table
summary(model)
shapiro.test(residuals(model))
par(mfrow = c(2, 2))
plot(model)
par(mfrow = c(1, 1))
qqPlot(model)
df |>
levene_test(body_mass_g~species)
df |>
filter(sex != '') |>
ggplot(aes(x=sex, y=body_mass_g))+
geom_boxplot()+
facet_wrap(~species)
skim(df)
model<- lm(data = na.omit(df), body_mass_g~sex*species)
anova(model)
test<-data.frame(tukey_hsd(model))
View(test)
model2<- lm(data = na.omit(df), body_mass_g~sex*species)
anova(model2)
model2<- aov(data = na.omit(df), body_mass_g~sex*species)
# now pass the model into the summary() function to generate an anova table
summary(model2)
test<-data.frame(tukey_hsd(model2))
test2<-data.frame(tukey_hsd(model2))
View(test2)
qqPlot(model)
df |>
levene_test(body_mass_g~species)
qqPlot(model2)
par(mfrow = c(2, 2))
plot(model2)
par(mfrow = c(1, 1))
qqPlot(model2)
df |>
levene_test(body_mass_g~species)
# Libraries and data ------------------------------------------------------
library(tidyverse)
library(car) # car package holds the Anova function, used for Type II and III anovas
library(rstatix) # for shapiro test and tukey_hsd
library(skimr) #for quick descriptive metrics of a data set
library(palmerpenguins)
df<-penguins
mod_interaction <- lm(body_mass_g ~ bill_length_mm, data = df)
summary(mod_interaction)
model_lm <- lm(body_mass_g ~ bill_length_mm, data = df)
summary(model_lm)
anova(model)
anova(model_lm)
model_lm <- lm(body_mass_g ~ bill_length_mm, data = na.omit(df))
summary(model_lm)
anova(model_lm)
ggplot(na.omit(df), aes(x = bill_length_mm, y = body_mass_g, color = species)) +
geom_point(alpha = 0.7, na.rm = TRUE) +
geom_smooth(method = "lm", se = TRUE, na.rm = TRUE) +
labs(
x = "Bill Length (mm)",
y = "Body Mass (g)",
color = "Species"
)
mod_interaction <- lm(body_mass_g ~ bill_length_mm * species, data = df)
summary(mod_interaction)
mod_additive <- lm(body_mass_g ~ bill_length_mm + species, data = df)
summary(mod_additive)
anova(mod_additive, mod_interaction)
df_centered<-df |>
mutate(bill_length_mm_centered = bill_length_mm - mean(bill_length_mm, na.rm = TRUE))
mod_interaction <- lm(body_mass_g ~ bill_length_mm_centered * species, data = df_centered)
summary(mod_interaction)
mod_additive <- lm(body_mass_g ~ bill_length_mm_centered + species, data = df_centered)
summary(mod_additive)
anova(mod_additive, mod_interaction)
summary(mod_interaction)
mod_interaction <- lm(body_mass_g ~ bill_length_mm * species, data = df)
summary(mod_interaction)
summary(mod_interaction)
mod_interaction <- lm(body_mass_g ~ bill_length_mm * species, data = df)
summary(mod_interaction)
df_centered<-df |>
mutate(bill_length_mm_centered = bill_length_mm - mean(bill_length_mm, na.rm = TRUE))
mod_interaction <- lm(body_mass_g ~ bill_length_mm_centered * species, data = df_centered)
summary(mod_interaction)
mod_additive <- lm(body_mass_g ~ bill_length_mm_centered + species, data = df_centered)
summary(mod_additive)
anova(mod_additive, mod_interaction)
mod_interaction <- lm(body_mass_g ~ bill_length_mm_centered * species, data = df_centered)
summary(mod_interaction)
mod_additive <- lm(body_mass_g ~ bill_length_mm + species, data = df)
summary(mod_additive)
mod_interaction <- lm(body_mass_g ~ bill_length_mm * species, data = df)
summary(mod_interaction)
mod_interaction <- lm(body_mass_g ~ bill_length_mm_centered * species, data = df_centered)
summary(mod_interaction)
mod_interaction <- lm(body_mass_g ~ bill_length_mm_centered * species, data = df_centered)
summary(mod_interaction)
anova(mod_interaction)
anova(mod_interaction)
df |>
filter(sex != '') |>
ggplot(aes(x=sex, y=body_mass_g))+
geom_boxplot()+
facet_wrap(~species)
skim(df)
model2<- lm(data = na.omit(df), body_mass_g~sex*species)
anova(model2)
model2<- aov(data = na.omit(df), body_mass_g~sex*species)
# now pass the model into the summary() function to generate an anova table
summary(model2)
test2<-data.frame(tukey_hsd(model2))
View(test2)
shapiro.test(residuals(model2))
par(mfrow = c(2, 2))
plot(model2)
par(mfrow = c(1, 1))
qqPlot(model2)
df |>
levene_test(body_mass_g~sex*species)
df |>
filter(sex != '') |>
ggplot(aes(x=sex, y=body_mass_g))+
geom_boxplot()+
facet_wrap(~species+island)
model2<- lm(data = na.omit(df), body_mass_g~sex*species*island)
anova(model2)
model2<- lm(data = na.omit(df), body_mass_g~species*island)
anova(model2)
model2<- aov(data = na.omit(df), body_mass_g~sex*species)
# now pass the model into the summary() function to generate an anova table
summary(model2)
df |>
filter(sex != '') |>
ggplot(aes(x=sex, y=body_mass_g))+
geom_boxplot()+
facet_wrap(~species+island)
df |>
filter(sex != '') |>
ggplot(aes(x=sex, y=body_mass_g, fill = species))+
geom_boxplot()+
facet_wrap(~island)
df_centered<-na.omit(df) |>
mutate(bill_length_mm_centered = bill_length_mm - mean(bill_length_mm, na.rm = TRUE))
mod_interaction <- lm(body_mass_g ~ bill_length_mm_centered * species, data = df_centered)
summary(mod_interaction)
mod_additive <- lm(body_mass_g ~ bill_length_mm_centered + species, data = df_centered)
summary(mod_additive)
anova(mod_additive, mod_interaction)
